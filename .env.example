PORT=3000

# Preferred AI Provider (optional: 'gemini', 'openai', 'anthropic', or 'auto')
AI_PROVIDER=auto

# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Rate Limiting (Max requests per 10 minutes per IP on /roast)
RATE_LIMIT_MAX=20

# Google OAuth 2.0 (From Google Cloud Console: https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Session Secret (Random string for secure cookie signing)
SESSION_SECRET=resume-roaster-secure-session-key-random
